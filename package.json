{
  "name": "dsh-read-aloud-edge",
  "version": "0.2.0",
  "type": "module",
  "description": "Read assistant replies aloud in DeepSeek Harness with Edge TTS and adjustable 1x-4x playback (Edge TTS edition, renamed from dsh-read-aloud to avoid an npm name clash).",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh",
    "tts",
    "read-aloud",
    "edge-tts",
    "speech",
    "accessibility"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "client.js",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "icon": "./icon.svg",
  "homepage": "https://github.com/hexiao160705-dev/dsh-read-aloud-edge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexiao160705-dev/dsh-read-aloud-edge.git"
  },
  "bugs": {
    "url": "https://github.com/hexiao160705-dev/dsh-read-aloud-edge/issues"
  }
}
